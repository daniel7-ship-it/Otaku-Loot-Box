# Set this only on the backend using a Cassius sandbox test key.
STRIPE_SECRET_KEY=sk_test_REPLACE_ON_BACKEND_ONLY
STOREFRONT_URL=https://daniel7-ship-it.github.io/Otaku-Loot-Box/
PORT=4242
HOST=127.0.0.1

# Required for embedded checkout, from the SAME sandbox as STRIPE_SECRET_KEY.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ON_BACKEND
# Merchant-approved, destination-specific shipping rules. Empty means unavailable.
# See EMBEDDED-CHECKOUT.md. Never paste listing estimates or test fixture rates here.
SHIPPING_RATES_JSON=[]

# Optional order recording: set all four privately, after running supabase-schema.sql.
# Do not also set ORDER_DATA_DIR when using Supabase.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_PRIVATELY
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_PRIVATELY
# ORDER_AGENT_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
